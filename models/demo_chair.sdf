<?xml version="1.0"?>
<!-- Mesh: Open Robotics Chair v3, Gazebo Fuel. See models/README.md. -->
<sdf version="1.8">
  <model name="demo_chair">
    <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 1.5708</pose>
      <visual name="visual">
        <geometry><mesh>
          <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/chair/3/files/meshes/Chair.obj</uri>
          <scale>0.00817 0.00817 0.00817</scale>
        </mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh>
          <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/chair/3/files/meshes/Chair.obj</uri>
          <scale>0.00817 0.00817 0.00817</scale>
        </mesh></geometry>
      </collision>
    </link>
  </model>
</sdf>
